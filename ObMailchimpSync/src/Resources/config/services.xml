<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="ObMailchimpSync\Service\MailchimpClient"/>

        <service id="ObMailchimpSync\Service\RecipientSynchronizer">
            <argument type="service" id="newsletter_recipient.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="ObMailchimpSync\Service\MailchimpClient"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="ObMailchimpSync\Subscriber\NewsletterRecipientSubscriber">
            <argument type="service" id="ObMailchimpSync\Service\RecipientSynchronizer"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="ObMailchimpSync\ScheduledTask\MailchimpSyncTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="ObMailchimpSync\ScheduledTask\MailchimpSyncTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="ObMailchimpSync\Service\RecipientSynchronizer"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="ObMailchimpSync\Command\MailchimpSyncCommand">
            <argument type="service" id="ObMailchimpSync\Service\RecipientSynchronizer"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
