{
    "name": "OnlyBubblesTheme",
    "author": "Bitbrew",
    "previewMedia": "app/storefront/src/assets/preview.png",
    "views": [
        "@Storefront",
        "@Plugins",
        "@WeineFeinkostTheme",
        "@OnlyBubblesTheme"
    ],
    "style": [
        "@WeineFeinkostTheme",
        "app/storefront/src/scss/base.scss"
    ],
    "script": [
        "@Storefront",
        "app/storefront/dist/storefront/js/only-bubbles-theme/only-bubbles-theme.js"
    ],
    "asset": [
        "@Storefront",
        "@WeineFeinkostTheme",
        "app/storefront/src/assets"
    ],
    "config": {
        "blocks": {
            "onlyBubblesLinks": {
                "label": {
                    "de-DE": "Only Bubbles — Links",
                    "en-GB": "Only Bubbles — Links"
                }
            }
        },
        "fields": {
            "ob-link-revocation": {
                "label": {
                    "de-DE": "Link „Bestellung widerrufen“ (Konto-Menü)",
                    "en-GB": "Link \"Revoke order\" (account menu)"
                },
                "helpText": {
                    "de-DE": "URL der Widerrufs-Formularseite, z. B. /widerruf-formular. Leer = Menüpunkt ausblenden.",
                    "en-GB": "URL of the revocation form page. Empty = hide menu item."
                },
                "type": "text",
                "value": "",
                "editable": true,
                "scss": false,
                "block": "onlyBubblesLinks"
            },
            "ob-link-dealer-register": {
                "label": {
                    "de-DE": "Link „Als Händler registrieren“ (Login-Seite)",
                    "en-GB": "Link \"Register as retailer\" (login page)"
                },
                "helpText": {
                    "de-DE": "URL der Händler-Registrierung. Leer = Button ausblenden.",
                    "en-GB": "URL of the retailer registration. Empty = hide button."
                },
                "type": "text",
                "value": "",
                "editable": true,
                "scss": false,
                "block": "onlyBubblesLinks"
            },
            "ob-link-shipping-info": {
                "label": {
                    "de-DE": "Link „Versand- & Zahlungsinfos“ (Warenkorb)",
                    "en-GB": "Link \"Shipping & payment info\" (cart)"
                },
                "helpText": {
                    "de-DE": "URL der Seite Versand & Zahlung. Leer = Link ausblenden.",
                    "en-GB": "URL of the shipping & payment page. Empty = hide link."
                },
                "type": "text",
                "value": "",
                "editable": true,
                "scss": false,
                "block": "onlyBubblesLinks"
            },
            "ob-free-shipping-bottles": {
                "label": {
                    "de-DE": "Kostenloser Versand ab … Flaschen (Warenkorb-Balken)",
                    "en-GB": "Free shipping from … bottles (cart progress bar)"
                },
                "helpText": {
                    "de-DE": "Nur Anzeige. 0 = Balken ausblenden. Die echten Versandkosten kommen aus den Versandregeln.",
                    "en-GB": "Display only. 0 = hide bar."
                },
                "type": "number",
                "value": 12,
                "editable": true,
                "scss": false,
                "block": "onlyBubblesLinks"
            }
        }
    }
}
