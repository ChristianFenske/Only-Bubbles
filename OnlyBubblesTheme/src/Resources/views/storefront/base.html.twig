{% sw_extends '@Storefront/storefront/base.html.twig' %}

{# Seite "Bestellung widerrufen" (Widerrufs-Plugin, Route frontend.revocation.form):
   Inhalt des Plugins links, Sidebar "So funktioniert's" rechts. Alle anderen Seiten unverändert. #}
{% block base_main_container %}
    {% if activeRoute is same as('frontend.revocation.form') %}
        <div class="ob-revocation">
            <div class="ob-revocation-main">
                {{ parent() }}
            </div>

            <aside class="ob-revocation-aside">
                <div class="ob-revocation-steps">
                    <span class="ob-revocation-bubble" aria-hidden="true"></span>
                    <span class="ob-revocation-bubble" aria-hidden="true"></span>
                    <div class="ob-revocation-steps-title">{{ 'obTheme.revocation.howTitle'|trans|sw_sanitize }}</div>
                    <ol>
                        <li><span>1</span>{{ 'obTheme.revocation.step1'|trans|sw_sanitize }}</li>
                        <li><span>2</span>{{ 'obTheme.revocation.step2'|trans|sw_sanitize }}</li>
                        <li><span>3</span>{{ 'obTheme.revocation.step3'|trans|sw_sanitize }}</li>
                    </ol>
                </div>

                <div class="ob-revocation-links">
                    {% if config('core.basicInformation.revocationPage') %}
                        <a href="{{ path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') }) }}"
                           data-ajax-modal="true"
                           data-url="{{ path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') }) }}">
                            {% sw_icon 'document-view' style { size: 'xs' } %}
                            {{ 'obTheme.revocation.readPolicy'|trans|sw_sanitize }}
                        </a>
                    {% endif %}
                    {% set obMail = config('core.basicInformation.email') ?: 'info@onlybubbles.de' %}
                    <a href="mailto:{{ obMail }}">
                        {% sw_icon 'envelope' style { size: 'xs' } %}
                        {{ obMail }}
                    </a>
                </div>
            </aside>
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Produktseite: Flasche in die Sticky-Kaufleiste (Plugin „Muto Sticky Buy Box“) einsetzen,
   falls das Plugin selbst kein Bild ausgibt. Gestaltung in scss/ob/_sticky-buy.scss #}
{% block base_body_script %}
    {{ parent() }}

    {# Bootstrap-Modals, die im Seiteninhalt stecken (z. B. Gewährleistungs-Hinweis in der Summenkarte),
       beim Öffnen an <body> hängen – sonst liegt der Hintergrund darüber und das Fenster lässt sich nicht schließen. #}
    <script>
        document.addEventListener('show.bs.modal', function (event) {
            var modal = event.target;
            if (modal && modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
        });
    </script>

    {# Magazin/Blog: Newsletter-Kasten ausblenden und „Zurück zum Magazin“ an den Beitrag ausrichten.
       Erkennung über URL bzw. Linktext, weil das Blog-Plugin keine festen Klassen liefert. #}
    <script>
        (function () {
            var back = null;
            var links = document.querySelectorAll('a');
            for (var i = 0; i < links.length; i++) {
                if (/zur(ü|ue)ck zum magazin/i.test(links[i].textContent)) { back = links[i]; break; }
            }
            if (back || /magazin|blog/i.test(window.location.pathname)) {
                document.body.classList.add('ob-magazin-page');
            }
            if (!back) { return; }

            back.classList.add('ob-blog-back');
            function align() {
                back.style.marginLeft = '';
                var start = back.getBoundingClientRect();
                var imgs = document.querySelectorAll('img');
                for (var j = 0; j < imgs.length; j++) {
                    var r = imgs[j].getBoundingClientRect();
                    if (r.width > 300 && r.top > start.top) {
                        back.style.marginLeft = Math.max(0, r.left - start.left) + 'px';
                        return;
                    }
                }
            }
            align();
            window.addEventListener('load', align);
            window.addEventListener('resize', align);
        })();
    </script>

    {% if activeRoute == 'frontend.detail.page' and page.product.cover.media.url is defined and page.product.cover.media.url %}
        {% set obStickyMedia = page.product.cover.media %}
        {% set obStickyThumb = obStickyMedia.thumbnails|filter(t => t.width >= 280)|sort((a, b) => a.width <=> b.width)|first %}
        <script>
            (function () {
                var src = {{ (obStickyThumb ? obStickyThumb.url : obStickyMedia.url)|json_encode|raw }};
                var alt = {{ (page.product.translated.name ?? '')|json_encode|raw }};

                // Weißen Bildhintergrund vom Rand her transparent machen (Etikett bleibt weiß)
                var cutout = null;
                function obCutout(done) {
                    var source = new Image();
                    source.onload = function () {
                        try {
                            var scale = Math.min(1, 400 / source.naturalHeight);
                            var w = Math.round(source.naturalWidth * scale);
                            var h = Math.round(source.naturalHeight * scale);
                            var canvas = document.createElement('canvas');
                            canvas.width = w;
                            canvas.height = h;
                            var ctx = canvas.getContext('2d');
                            ctx.drawImage(source, 0, 0, w, h);
                            var data = ctx.getImageData(0, 0, w, h);
                            var px = data.data;
                            var seen = new Uint8Array(w * h);
                            var stack = [];
                            var isBg = function (i) {
                                return px[i * 4 + 3] < 20 || (px[i * 4] > 232 && px[i * 4 + 1] > 232 && px[i * 4 + 2] > 232);
                            };
                            for (var x = 0; x < w; x++) { stack.push(x, (h - 1) * w + x); }
                            for (var y = 0; y < h; y++) { stack.push(y * w, y * w + w - 1); }
                            while (stack.length) {
                                var i = stack.pop();
                                if (seen[i] || !isBg(i)) { continue; }
                                seen[i] = 1;
                                px[i * 4 + 3] = 0;
                                var cx = i % w;
                                if (cx > 0) { stack.push(i - 1); }
                                if (cx < w - 1) { stack.push(i + 1); }
                                if (i >= w) { stack.push(i - w); }
                                if (i < (h - 1) * w) { stack.push(i + w); }
                            }
                            ctx.putImageData(data, 0, 0);

                            // Auf die Flasche zuschneiden (leeren Rand entfernen)
                            var minX = w, minY = h, maxX = -1, maxY = -1;
                            for (var j = 0; j < w * h; j++) {
                                if (px[j * 4 + 3] > 20) {
                                    var jx = j % w, jy = (j - jx) / w;
                                    if (jx < minX) { minX = jx; }
                                    if (jx > maxX) { maxX = jx; }
                                    if (jy < minY) { minY = jy; }
                                    if (jy > maxY) { maxY = jy; }
                                }
                            }
                            if (maxX >= minX && maxY >= minY) {
                                var crop = document.createElement('canvas');
                                crop.width = maxX - minX + 1;
                                crop.height = maxY - minY + 1;
                                crop.getContext('2d').drawImage(canvas, minX, minY, crop.width, crop.height, 0, 0, crop.width, crop.height);
                                canvas = crop;
                            }
                            cutout = canvas.toDataURL('image/png');
                        } catch (e) {
                            cutout = src; // Bild von fremder Domain: Original verwenden
                        }
                        done();
                    };
                    source.onerror = function () { cutout = src; done(); };
                    source.src = src;
                }

                function obStickyBottle() {
                    var left = document.querySelector('.muto-sticky-buy-box__left');
                    if (!cutout || !left || left.querySelector('.muto-sticky-buy-box__image')) {
                        return;
                    }
                    var wrap = document.createElement('div');
                    wrap.className = 'muto-sticky-buy-box__image ob-sticky-bottle';
                    var img = document.createElement('img');
                    img.src = cutout;
                    img.alt = alt;
                    wrap.appendChild(img);
                    left.insertBefore(wrap, left.firstChild);
                }

                obCutout(obStickyBottle);

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', obStickyBottle);
                } else {
                    obStickyBottle();
                }
                // Plugin kann die Leiste neu aufbauen (z. B. Variantenwechsel)
                new MutationObserver(obStickyBottle).observe(document.body, { childList: true, subtree: true });
            })();
        </script>
    {% endif %}
{% endblock %}
