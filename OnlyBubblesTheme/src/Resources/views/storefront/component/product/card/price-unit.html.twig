{% sw_extends '@Storefront/storefront/component/product/card/price-unit.html.twig' %}

{% block component_product_box_price_info %}
    {% set obPriceLocked = not (context.customer and not context.customer.guest)
        and ((product.translated.customFields ?? {})|merge(product.customFields ?? {})|filter((v, k) => v and ('login' in k|lower or 'anmeld' in k|lower or 'einlogg' in k|lower))|length > 0) %}
    {% if obPriceLocked %}
        <div class="product-price-info ob-price-login-info">
            {% sw_include '@OnlyBubblesTheme/storefront/component/ob/price-login-hint.html.twig' with { obCompact: true } %}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
