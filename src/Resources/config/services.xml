<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <service id="WeineFeinkostTheme\Subscriber\FooterMainNavSubscriber"/>
		
		<!-- simplest: explicit tag -->
        <service id="WeineFeinkostTheme\Subscriber\ProductListingSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
		<service id="WeineFeinkostTheme\Subscriber\WishlistPageSubscriber">
			<tag name="kernel.event_subscriber"/>
		</service>
		<service id="WeineFeinkostTheme\Subscriber\CmsProductCriteriaSubscriber">
			<tag name="kernel.event_subscriber"/>
		</service>
		<service id="WeineFeinkostTheme\Cms\WeineProductSliderCmsElementResolver"
				 decorates="Shopware\Core\Content\Product\Cms\ProductSliderCmsElementResolver">
			<argument type="service" id="WeineFeinkostTheme\Cms\WeineProductSliderCmsElementResolver.inner"/>
			<argument type="service" id="sales_channel.product.repository"/>
			<tag name="shopware.cms.data_resolver"/>
		</service>
        <!-- Decorate the core product-box cms element resolver -->
		<service id="WeineFeinkostTheme\Cms\WeineProductBoxCmsElementResolver"
				 decorates="Shopware\Core\Content\Product\Cms\ProductBoxCmsElementResolver"
				 decoration-priority="1000">

			<argument type="service" id="WeineFeinkostTheme\Cms\WeineProductBoxCmsElementResolver.inner"/>
			<argument type="service" id="sales_channel.product.repository"/>

			<tag name="shopware.cms.data_resolver" priority="1000"/>
		</service>
        <service id="WeineFeinkostTheme\Subscriber\ProductPageSubscriber">
            <argument type="service" id="category.repository" />
            <tag name="kernel.event_subscriber" />
        </service>
		<service id="WeineFeinkostTheme\Subscriber\CartPropertiesSubscriber">
			<argument type="service" id="product.repository"/>
			<tag name="kernel.event_subscriber"/>
		</service>
		<service id="WeineFeinkostTheme\Subscriber\ProductSearchSubscriber">
			<tag name="kernel.event_subscriber"/>
		</service>
		
		<service id="WeineFeinkostTheme\Subscriber\BilobaManufacturerDetailSubscriber">
			<tag name="kernel.event_subscriber"/>
		</service>		
		<service id="WeineFeinkostTheme\Subscriber\SimilarProductsCriteriaSubscriber">
			<tag name="kernel.event_subscriber"/>
		</service>
		<!-- Such-Dropdown: Kategorien der Treffer mit Anzahl (Template: extensions.wfSuggest) -->
		<service id="WeineFeinkostTheme\Subscriber\SearchSuggestSubscriber">
			<argument type="service" id="category.repository"/>
			<argument type="service" id="logger"/>
			<tag name="kernel.event_subscriber"/>
		</service>
    </services>
</container>
