{
    "name": "WeineFeinkostTheme",
    "author": "Bitbrew",
	"previewMedia": "app/storefront/src/assets/preview.png",
    "views": [
        "@Storefront",
        "@Plugins",
        "@WeineFeinkostTheme"
    ],
    "style": [
        "app/storefront/src/scss/overrides.scss",
        "@Storefront",
        "app/storefront/src/scss/base.scss"
    ],
    "script": [
        "@Storefront"
    ],
    "asset": [
        "@Storefront",
        "app/storefront/src/assets"
    ],
    "config": {
        "blocks": {
            "wfDesign": {
                "label": {
                    "de-DE": "Warenkorb, Checkout & Menüs",
                    "en-GB": "Cart, checkout & menus"
                }
            }
        },
        "fields": {
            "wf-checkout-design": {
                "label": {
                    "de-DE": "Neues Warenkorb- & Checkout-Design",
                    "en-GB": "New cart & checkout design"
                },
                "helpText": {
                    "de-DE": "Warenkorb, Checkout, Bestellabschluss, Widerrufsseite, Konto-Menü und aufgeklapptes Hauptmenü im neuen Aufbau. Aus = bisheriges Design.",
                    "en-GB": "Cart, checkout, order confirmation, revocation page, account menu and mega menu in the new layout. Off = previous design."
                },
                "type": "switch",
                "value": true,
                "editable": true,
                "scss": false,
                "block": "wfDesign"
            }
        }
    }
}