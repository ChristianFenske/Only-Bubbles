{
    "name": "WeineFeinkostTheme",
    "author": "Bitbrew",
	"previewMedia": "app/storefront/src/assets/preview.png",
    "views": [
        "@Storefront",
        "@Plugins",
        "@WeineFeinkostTheme"
    ],
    "style": [
        "app/storefront/src/scss/overrides.scss",
        "@Storefront",
        "app/storefront/src/scss/base.scss"
    ],
    "script": [
        "@Storefront"
    ],
    "asset": [
        "@Storefront",
        "app/storefront/src/assets"
    ],
    "config": {
        "blocks": {
            "wfDesign": {
                "label": {
                    "de-DE": "Konto, Warenkorb, Checkout & Menüs",
                    "en-GB": "Account, cart, checkout & menus"
                }
            }
        },
        "fields": {
            "wf-checkout-design": {
                "label": {
                    "de-DE": "Neues Warenkorb- & Checkout-Design",
                    "en-GB": "New cart & checkout design"
                },
                "helpText": {
                    "de-DE": "Konto, Warenkorb, Checkout, Bestellabschluss, Widerrufsseite, Konto-Menü, aufgeklapptes Hauptmenü, Such-Dropdown und Sticky-Kaufleiste im neuen Aufbau. Aus = bisheriges Design.",
                    "en-GB": "Account, cart, checkout, order confirmation, revocation page, account menu, mega menu, search dropdown and sticky buy bar in the new layout. Off = previous design."
                },
                "type": "switch",
                "value": true,
                "editable": true,
                "scss": false,
                "block": "wfDesign"
            },
            "wf-mega-popular": {
                "label": {
                    "de-DE": "Menü Länder/Regionen: „Beliebt“",
                    "en-GB": "Countries/regions menu: \"Popular\""
                },
                "helpText": {
                    "de-DE": "Regionen mit Komma getrennt, z. B. Bordeaux, Burgund, Toskana. Leer = ausblenden.",
                    "en-GB": "Regions separated by commas, e.g. Bordeaux, Burgund, Toskana. Empty = hide."
                },
                "type": "text",
                "value": "Bordeaux, Burgund, Toskana, Rioja, Mosel, Wachau",
                "editable": true,
                "scss": false,
                "block": "wfDesign"
            }
        }
    }
}