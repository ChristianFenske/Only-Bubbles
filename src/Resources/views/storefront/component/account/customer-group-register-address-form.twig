{% sw_extends '@Storefront/storefront/component/account/customer-group-register-address-form.twig' %}

{% set wfDesign = theme_config('wf-checkout-design') %}

{# Händlerregistrierung: immer gewerblich – keine Auswahl Privat/Gewerblich #}
{% block component_address_personal_account_type %}
    {% if wfDesign %}
        <input type="hidden" name="{% if prefix %}{{ prefix }}[accountType]{% else %}accountType{% endif %}" value="{{ constant('Shopware\\Core\\Checkout\\Customer\\CustomerEntity::ACCOUNT_TYPE_BUSINESS') }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
