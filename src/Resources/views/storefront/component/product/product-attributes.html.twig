{# Only Bubbles — Wein-Attribute für Produktkacheln (aus Properties/Eigenschaften).
   Struktur/Logik von Fenskes übernommen, aber im Gold-Design mit Inline-SVGs. #}
{% set isListingCard = isListingCard|default(false) %}

{% set flagMap = {
    'Frankreich': '🇫🇷', 'Deutschland': '🇩🇪', 'Italien': '🇮🇹', 'Spanien': '🇪🇸',
    'Österreich': '🇦🇹', 'Portugal': '🇵🇹', 'Argentinien': '🇦🇷', 'Chile': '🇨🇱',
    'Australien': '🇦🇺', 'Neuseeland': '🇳🇿', 'Südafrika': '🇿🇦', 'USA': '🇺🇸',
    'Georgien': '🇬🇪', 'Ungarn': '🇭🇺', 'Griechenland': '🇬🇷', 'Schweiz': '🇨🇭',
    'China': '🇨🇳', 'Israel': '🇮🇱'
} %}

{% set p = { rebsorten: [], ausbau: '', jahr: '', region: '', land: '', art: '', alkohol: '' } %}
{% for group in product.sortedProperties %}
    {% set gn = group.translated.name %}
    {% for option in group.options %}
        {% set v = option.translated.name %}
        {% if gn == 'Rebsorten' %}{% set p = p|merge({ rebsorten: p.rebsorten|merge([v]) }) %}{% endif %}
        {% if gn == 'Ausbau' %}{% set p = p|merge({ ausbau: v }) %}{% endif %}
        {% if gn == 'Jahr' %}{% set p = p|merge({ jahr: v }) %}{% endif %}
        {% if gn == 'Region' %}{% set p = p|merge({ region: v }) %}{% endif %}
        {% if gn == 'Land' %}{% set p = p|merge({ land: v }) %}{% endif %}
        {% if gn == 'Art' %}{% set p = p|merge({ art: v }) %}{% endif %}
        {% if gn == 'Alkoholgehalt' %}{% set p = p|merge({ alkohol: v }) %}{% endif %}
    {% endfor %}
{% endfor %}

{% set styleText = p.rebsorten|length > 1 ? 'Cuvée' : (p.rebsorten|first|default('')) %}
{% if p.ausbau %}{% set styleText = (styleText ? styleText ~ ', ' : '') ~ p.ausbau %}{% endif %}

<div class="ob-attrs">
    {% if styleText %}
        <div class="ob-attr-row">
            <svg class="ob-attr-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M8 8a2 2 0 1 0 4 0 2 2 0 1 0 4 0M6 13a2 2 0 1 0 4 0 2 2 0 1 0 4 0M9 18a2 2 0 1 0 4 0"/></svg>
            <span>{{ styleText }}</span>
        </div>
    {% endif %}

    {% if p.jahr and not isListingCard %}
        <div class="ob-attr-row">
            <svg class="ob-attr-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            <span>{{ p.jahr }}</span>
        </div>
    {% endif %}

    {% if p.region or p.land %}
        <div class="ob-attr-row">
            <svg class="ob-attr-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{{ p.region ?: p.land }}</span>
            {% if p.land and flagMap[p.land] is defined %}<span class="ob-flag">{{ flagMap[p.land] }}</span>{% endif %}
        </div>
    {% endif %}
</div>
