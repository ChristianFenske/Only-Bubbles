{# Only Bubbles — ersetzt das Standard-„Beschreibung/Bewertungen"-Tab-Element
   durch die Design-Sektionen: Anker-Navi + Zum Wein / Zum Winzer / Steckbrief /
   Zur Rebsorte. Bewertungen werden am Ende weiterhin eingebunden.

   Wein-Daten via Custom Fields — zentrales Mapping unten (anpassbar). #}
{% block element_product_description_reviews %}
    {% set product = element.data.product %}

    {% if product %}
        {% set cf = product.translated.customFields ?? product.customFields ?? {} %}
        {% set ob = {
            region:    cf.only_bubbles_region|default(''),
            country:   cf.only_bubbles_country|default(''),
            alcohol:   cf.only_bubbles_alcohol|default(''),
            grapes:    cf.only_bubbles_grapes|default(''),
            aging:     cf.only_bubbles_aging|default(''),
            cru:       cf.only_bubbles_cru|default(''),
            dosage:    cf.only_bubbles_dosage|default(''),
            type:      cf.only_bubbles_type|default(''),
            energy:    cf.only_bubbles_energy|default(''),
            vintage:   cf.only_bubbles_vintage|default(''),
            bio:       cf.only_bubbles_bio|default(false),
            grapeInfo: cf.only_bubbles_grape_info|default('')
        } %}

        <div class="ob-pdp cms-element-{{ element.type }}">

            {# ===== Anker-Navigation ===== #}
            <nav class="ob-anchor-nav">
                <div class="ob-anchor-inner">
                    {% if product.translated.description %}
                        <a href="#ob-wein" class="ob-link">{{ 'onlyBubbles.pdp.toWine'|trans|default('Zum Wein') }}</a>
                    {% endif %}
                    {% if product.manufacturer %}
                        <a href="#ob-winzer" class="ob-link">{{ 'onlyBubbles.pdp.toMaker'|trans|default('Zum Winzer') }}</a>
                    {% endif %}
                    <a href="#ob-steckbrief" class="ob-link">{{ 'onlyBubbles.pdp.toFacts'|trans|default('Steckbrief') }}</a>
                    {% if ob.grapeInfo %}
                        <a href="#ob-rebsorte" class="ob-link">{{ 'onlyBubbles.pdp.toGrape'|trans|default('Zur Rebsorte') }}</a>
                    {% endif %}
                </div>
            </nav>

            {# ===== Zum Wein ===== #}
            {% if product.translated.description %}
                <section id="ob-wein" class="ob-pdp-section">
                    <div class="ob-section-head">
                        <span class="ob-section-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 22h8M12 11v11M5 3h14l-1 6a6 6 0 0 1-12 0z"/></svg>
                        </span>
                        <h2 class="ob-section-title">Zum <strong>Wein</strong></h2>
                        <span class="ob-section-rule"></span>
                    </div>
                    <h3 class="ob-section-sub">{{ 'onlyBubbles.pdp.description'|trans|default('Detailbeschreibung') }}</h3>
                    <div class="ob-prose">{{ product.translated.description|raw }}</div>
                </section>
            {% endif %}

            {# ===== Zum Winzer ===== #}
            {% if product.manufacturer %}
                {% set m = product.manufacturer %}
                <section id="ob-winzer" class="ob-pdp-section">
                    <div class="ob-section-head">
                        <span class="ob-section-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2h8M9 2v4.5a6 6 0 0 0 6 0V2M7 22a5 5 0 0 1 10 0z"/></svg>
                        </span>
                        <h2 class="ob-section-title">Zum <strong>Winzer</strong></h2>
                        <span class="ob-section-rule"></span>
                    </div>
                    <div class="ob-winzer">
                        {% if m.media %}
                            <div class="ob-winzer-img">
                                {% sw_thumbnails 'ob-winzer-img-thumb' with {
                                    media: m.media,
                                    sizes: { default: '380px' }
                                } %}
                            </div>
                        {% endif %}
                        <div class="ob-winzer-body">
                            <h3 class="ob-winzer-name">{{ m.translated.name }}</h3>
                            {% if m.translated.description %}
                                <div class="ob-winzer-quote">{{ m.translated.description|raw }}</div>
                            {% endif %}
                            {% if m.link %}
                                <a href="{{ m.link }}" class="ob-winzer-btn">
                                    {{ 'onlyBubbles.pdp.allWines'|trans|default('Alle Weine des Winzers') }}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endif %}

            {# ===== Steckbrief ===== #}
            <section id="ob-steckbrief" class="ob-pdp-section">
                <div class="ob-section-head">
                    <span class="ob-section-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
                    </span>
                    <h2 class="ob-section-title">Steck<strong>brief</strong></h2>
                    <span class="ob-section-rule"></span>
                </div>
                {% set specsLeft = [
                    { k: 'Artikelnr.', v: product.productNumber },
                    { k: 'Land', v: ob.country },
                    { k: 'Region', v: ob.region },
                    { k: 'Art', v: ob.type },
                    { k: 'Rebsorten', v: ob.grapes },
                    { k: 'Brennwert / 100 ml', v: ob.energy }
                ] %}
                {% set specsRight = [
                    { k: 'Jahrgang', v: ob.vintage },
                    { k: 'Lage', v: ob.cru },
                    { k: 'Ausbau', v: ob.aging },
                    { k: 'Alkoholgehalt', v: ob.alcohol },
                    { k: 'Dosage', v: ob.dosage },
                    { k: 'Anbau', v: ob.bio ? 'biologisch (BIO)' : '' }
                ] %}
                <div class="ob-steckbrief">
                    <div class="ob-steckbrief-col">
                        {% for s in specsLeft|filter(s => s.v) %}
                            <div class="ob-spec-row"><span class="ob-spec-k">{{ s.k }}</span><span class="ob-spec-v">{{ s.v }}</span></div>
                        {% endfor %}
                    </div>
                    <div class="ob-steckbrief-col">
                        {% for s in specsRight|filter(s => s.v) %}
                            <div class="ob-spec-row"><span class="ob-spec-k">{{ s.k }}</span><span class="ob-spec-v">{{ s.v }}</span></div>
                        {% endfor %}
                    </div>
                </div>
            </section>

            {# ===== Zur Rebsorte (optional) ===== #}
            {% if ob.grapeInfo %}
                <section id="ob-rebsorte" class="ob-pdp-section ob-pdp-section--alt">
                    <div class="ob-section-head">
                        <span class="ob-section-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M8 8a2 2 0 1 0 4 0 2 2 0 1 0 4 0M6 13a2 2 0 1 0 4 0 2 2 0 1 0 4 0M9 18a2 2 0 1 0 4 0"/></svg>
                        </span>
                        <h2 class="ob-section-title">Zur <strong>Rebsorte</strong></h2>
                        <span class="ob-section-rule"></span>
                    </div>
                    <div class="ob-prose">{{ ob.grapeInfo|raw }}</div>
                </section>
            {% endif %}

            {# ===== Bewertungen (Funktion erhalten) ===== #}
            {% if config('core.listing.showReview') %}
                <section class="ob-pdp-section">
                    {% sw_include '@Storefront/storefront/component/review/review.html.twig' with {
                        reviews: element.data.reviews,
                        product: product
                    } %}
                </section>
            {% endif %}

        </div>
    {% endif %}
{% endblock %}
