{# Only Bubbles — füllt das Beschreibungs-Element (steht im Layout direkt nach
   dem Hero, vor "Ähnliche Artikel") mit den Design-Sektionen. Im Layout ist der
   Block per d-none versteckt; base.scss blendet ihn wieder ein -> dadurch sitzen
   die Sektionen automatisch an der richtigen Stelle (vor Cross-Selling/Newsletter).
   Daten aus Produkt-Properties (Eigenschaften). #}
{% sw_extends '@Storefront/storefront/element/cms-element-product-description-reviews.html.twig' %}

{% block element_product_description_reviews %}
    {% set product = element.data.product %}
    {% if product %}
        {% set rows = [{ k: 'Artikelnr.', v: product.productNumber }] %}
        {% for g in product.sortedProperties %}
            {% set vals = [] %}
            {% for o in g.options %}{% set vals = vals|merge([o.translated.name]) %}{% endfor %}
            {% set rows = rows|merge([{ k: g.translated.name, v: vals|join(', ') }]) %}
        {% endfor %}
        {% set half = (rows|length / 2)|round(0, 'ceil') %}

        <div class="ob-pdp">

            <nav class="ob-anchor-nav">
                <div class="ob-anchor-inner">
                    {% if product.translated.description %}<a href="#ob-wein" class="ob-link">{{ 'onlyBubbles.pdp.toWine'|trans|default('Zum Wein') }}</a>{% endif %}
                    {% if product.manufacturer %}<a href="#ob-winzer" class="ob-link">{{ 'onlyBubbles.pdp.toMaker'|trans|default('Zum Winzer') }}</a>{% endif %}
                    <a href="#ob-steckbrief" class="ob-link">{{ 'onlyBubbles.pdp.toFacts'|trans|default('Steckbrief') }}</a>
                </div>
            </nav>

            {% if product.translated.description %}
                <section id="ob-wein" class="ob-pdp-section">
                    <div class="ob-section-head">
                        <span class="ob-section-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 22h8M12 11v11M5 3h14l-1 6a6 6 0 0 1-12 0z"/></svg></span>
                        <h2 class="ob-section-title">Zum <strong>Wein</strong></h2>
                        <span class="ob-section-rule"></span>
                    </div>
                    <h3 class="ob-section-sub">{{ 'onlyBubbles.pdp.description'|trans|default('Detailbeschreibung') }}</h3>
                    <div class="ob-prose">{{ product.translated.description|raw }}</div>
                </section>
            {% endif %}

            {% if product.manufacturer %}
                {% set m = product.manufacturer %}
                <section id="ob-winzer" class="ob-pdp-section">
                    <div class="ob-section-head">
                        <span class="ob-section-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2h8M9 2v4.5a6 6 0 0 0 6 0V2M7 22a5 5 0 0 1 10 0z"/></svg></span>
                        <h2 class="ob-section-title">Zum <strong>Winzer</strong></h2>
                        <span class="ob-section-rule"></span>
                    </div>
                    <div class="ob-winzer">
                        {% if m.media and m.media.url %}
                            <div class="ob-winzer-img"><img src="{{ m.media.url }}" alt="{{ m.translated.name }}" loading="lazy"></div>
                        {% endif %}
                        <div class="ob-winzer-body">
                            <h3 class="ob-winzer-name">{{ m.translated.name }}</h3>
                            {% if m.translated.description %}<div class="ob-winzer-quote">{{ m.translated.description|raw }}</div>{% endif %}
                            {% if m.link %}
                                <a href="{{ m.link }}" class="ob-winzer-btn">{{ 'onlyBubbles.pdp.allWines'|trans|default('Alle Weine des Winzers') }}
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% endif %}

            <section id="ob-steckbrief" class="ob-pdp-section">
                <div class="ob-section-head">
                    <span class="ob-section-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg></span>
                    <h2 class="ob-section-title">Steck<strong>brief</strong></h2>
                    <span class="ob-section-rule"></span>
                </div>
                <div class="ob-steckbrief">
                    <div class="ob-steckbrief-col">
                        {% for s in rows|slice(0, half) %}{% if s.v %}<div class="ob-spec-row"><span class="ob-spec-k">{{ s.k }}</span><span class="ob-spec-v">{{ s.v }}</span></div>{% endif %}{% endfor %}
                    </div>
                    <div class="ob-steckbrief-col">
                        {% for s in rows|slice(half) %}{% if s.v %}<div class="ob-spec-row"><span class="ob-spec-k">{{ s.k }}</span><span class="ob-spec-v">{{ s.v }}</span></div>{% endif %}{% endfor %}
                    </div>
                </div>
            </section>

        </div>
    {% endif %}
{% endblock %}
