{# Only Bubbles — laedt die Theme-Schriften (Cormorant Garamond + Jost) per
   <link> im <head>. Bewusst NICHT per SCSS-@import, da Shopwares Theme-Compiler
   an Remote-@import-url scheitern kann. #}
{% sw_extends '@Storefront/storefront/layout/meta.html.twig' %}

{% block layout_head_stylesheet %}
    {{ parent() }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap">
{% endblock %}
