{% sw_extends '@Storefront/storefront/page/account/addressbook/address-manager.html.twig' %}

{% set wfDesign = theme_config('wf-checkout-design') %}

{# Überschriften über den beiden Standard-Adressen (Desktop). Mobil zeigt das Badge den Typ. #}
{% block address_base_default_address %}
    {% if wfDesign %}
        <div class="row g-3 wf-default-address-headings d-none d-lg-flex" aria-hidden="true">
            <p class="col-lg-6 wf-default-address-heading">{{ 'wfTheme.account.defaultShipping'|trans|sw_sanitize }}</p>
            <p class="col-lg-6 wf-default-address-heading">{{ 'wfTheme.account.defaultBilling'|trans|sw_sanitize }}</p>
        </div>
        {{ parent() }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block address_base_list_create_address %}
    {% if wfDesign %}
        <a href="{{ path('frontend.account.address.create.page') }}"
           class="address-manager-modal-address-form btn wf-btn-outline flex-shrink-0">
            {% sw_icon 'plus' style { size: 'xs' } %}
            {{ 'account.addressCreateBtn'|trans|sw_sanitize }}
        </a>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
