{% sw_extends '@Storefront/storefront/section/cms-section-sidebar.html.twig' %}

{% block page_content_section_sidebar_row %}
	<div class="row category-content-row">
		<div class="cms-section-sidebar-sidebar-content col-lg-4 col-xl-3"></div>
		<div class="cms-section-sidebar-main-content col-lg-8 col-xl-9">
			<div class="category-content-box">
				{% if page.category.media.url %}
					<div class="category-image-container">
						<img class="category-image" src="{{ page.category.media.url }}" title="{{ page.category.translated.name }}">
					</div>
				{% endif %}
				{% if page.category.translated.name %}
					<div class="category-text">
						<h1>{{ page.category.translated.name }}</h1>
						
						{% set description = page.category.translated.description %}
						{% set description = description|replace({
							'<hr />': '<hr>',
							'<hr/>': '<hr>'
						}) %}

						{% set parts = description|split('<hr>') %}
						
						{{ parts[0]|raw }}
						
						{% if parts|length > 1 %}
							<a href="#categoryReadMore">
								{{ 'categoryRow.readMoreLinkPart1'|trans }} "{{ page.category.translated.name }}" {{ 'categoryRow.readMoreLinkPart2'|trans }}
							</a>
						{% endif %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	{{ parent() }}
	
	{% if parts|length > 1 %}
		<div class="row category-read-more-row">
			<div class="cms-section-sidebar-sidebar-content col-lg-4 col-xl-3"></div>
			<div class="cms-section-sidebar-main-content col-lg-8 col-xl-9">
				<div id="categoryReadMore">
					<h3>{{ 'categoryRow.inDetailTitle'|trans }}</h3>
					<h2>{{ page.category.translated.name }}</h2>
					<div class="categoty-read-more-text">
						{{ parts[1]|raw }}
					</div>	
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}
